{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "navConfig.ts",
    "rn_tokens.ts",
    "design_tokens.json",
    "types/**/*.ts",
    "rn/**/*.ts",
    "domain/**/*.ts"
  ]
}
