{
  "meta": {
    "name": "Kyarafit Design Tokens",
    "version": "0.3.0",
    "source": "web runtime source of truth"
  },
  "themes": {
    "light": {
      "color": {
        "background": {
          "base": "#F7F3EB",
          "warm": "#EFE9DE",
          "surface": "#FFFDF8",
          "surfaceWarm": "#F8F2E8",
          "muted": "#ECE7DE",
          "mutedWarm": "#E4DDD2",
          "panel": "#F5F1E8",
          "panelRaised": "#FBF8F2",
          "overlay": "rgba(247,243,235,0.92)"
        },
        "text": {
          "primary": "#171629",
          "secondary": "rgba(23,22,41,0.72)",
          "tertiary": "rgba(23,22,41,0.52)",
          "muted": "rgba(23,22,41,0.36)",
          "meta": "rgba(23,22,41,0.60)"
        },
        "border": {
          "default": "rgba(23,22,41,0.14)",
          "subtle": "rgba(23,22,41,0.08)",
          "card": "rgba(23,22,41,0.16)",
          "strong": "#171629",
          "dashed": "rgba(23,22,41,0.16)"
        },
        "accent": {
          "primary": "#3B56D6",
          "soft": "rgba(59,86,214,0.12)"
        },
        "state": {
          "danger": "#D1495B"
        }
      }
    },
    "dark": {
      "color": {
        "background": {
          "base": "#171726",
          "warm": "#1D1E2C",
          "surface": "#202132",
          "surfaceWarm": "#25263A",
          "muted": "#2A2C40",
          "mutedWarm": "#313349",
          "panel": "#232435",
          "panelRaised": "#2B2D3E",
          "overlay": "rgba(23,23,38,0.92)"
        },
        "text": {
          "primary": "#F5F0E8",
          "secondary": "rgba(245,240,232,0.76)",
          "tertiary": "rgba(245,240,232,0.56)",
          "muted": "rgba(245,240,232,0.38)",
          "meta": "rgba(245,240,232,0.62)"
        },
        "border": {
          "default": "rgba(245,240,232,0.14)",
          "subtle": "rgba(245,240,232,0.08)",
          "card": "rgba(245,240,232,0.16)",
          "strong": "#F5F0E8",
          "dashed": "rgba(245,240,232,0.16)"
        },
        "accent": {
          "primary": "#90A4FF",
          "soft": "rgba(144,164,255,0.16)"
        },
        "state": {
          "danger": "#FF7A8A"
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["Albert Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "serifDisplay": ["Bodoni Moda", "Georgia", "serif"],
      "serifElegant": ["Bodoni Moda", "Georgia", "serif"],
      "sansWide": ["Albert Sans", "system-ui", "sans-serif"],
      "mono": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
    },
    "roles": {
      "displayHero": { "family": "serifElegant", "weight": 400, "style": "italic" },
      "displayTitle": { "family": "serifDisplay", "weight": 400, "style": "italic" },
      "headingSerif": { "family": "serifDisplay", "weight": 700, "style": "italic" },
      "body": { "family": "sans", "weight": 500, "style": "normal" },
      "bodyLight": { "family": "sans", "weight": 400, "style": "normal" },
      "labelWide": {
        "family": "sansWide",
        "weight": 700,
        "style": "normal",
        "transform": "uppercase",
        "letterSpacingEm": 0.18
      },
      "metaLabel": {
        "family": "sansWide",
        "weight": 700,
        "style": "normal",
        "transform": "uppercase",
        "letterSpacingEm": 0.16
      }
    },
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 38,
      "5xl": 52
    },
    "tracking": {
      "meta": "0.16em",
      "wide": "0.18em",
      "wider": "0.24em",
      "widest": "0.32em"
    }
  },
  "spacing": {
    "unitPx": 4,
    "scale": {
      "0": 0,
      "0_5": 2,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "6": 24,
      "8": 32,
      "12": 48,
      "16": 64,
      "24": 96
    },
    "layout": {
      "screenPaddingX": 24,
      "screenPaddingXWide": 32,
      "sectionGap": 64,
      "stackGap": 24,
      "gridGap": 16
    }
  },
  "radius": {
    "none": 0,
    "sm": 6,
    "base": 10,
    "md": 14,
    "lg": 18,
    "xl": 28
  },
  "borderWidth": {
    "hairline": 0.5,
    "thin": 1,
    "thick": 2
  },
  "shadow": {
    "soft": "0 28px 60px -32px rgba(23,22,41,0.20)",
    "card": "0 18px 40px -28px rgba(23,22,41,0.18)",
    "fab": "0 18px 36px -18px rgba(23,22,41,0.26)"
  },
  "motion": {
    "duration": {
      "fastMs": 140,
      "baseMs": 220,
      "slowMs": 360
    },
    "easing": {
      "standard": "cubic-bezier(0.23, 1, 0.32, 1)",
      "emphasized": "cubic-bezier(0.32, 0.72, 0, 1)"
    }
  }
}
