# Copy this file to docker-compose.override.yml and add your actual credentials
# docker-compose.override.yml is gitignored and will override values from docker-compose.yml

services:
  backend:
    environment:
      # Replace with your actual Supabase credentials
      - SUPABASE_URL=https://your-project.supabase.co
      - JWT_SECRET=your-jwt-secret-from-supabase
      - SUPABASE_SERVICE_KEY=your-service-role-key
      
      # Optional: Stripe credentials
      - STRIPE_PRICE_BASIC=price_xxx
      - STRIPE_PRICE_PRO=price_yyy
