# Database (local development)
DATABASE_URL=postgres://username:password@localhost:5433/kyarafit?sslmode=disable

# Database (Supabase - production)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres
DB_HOST=localhost
DB_PORT=5433
DB_USER=kyarafit
DB_PASSWORD=password
DB_NAME=kyarafit

# Server
PORT=8080
HOST=0.0.0.0

# JWT (Supabase)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase
JWT_SECRET=your-jwt-secret-from-supabase

# Stripe (tier mapping: price_id -> PREMIUM_BASIC / PREMIUM_PRO)
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_yyy

# Optional: Image processing service (for background removal with rembg)
IMAGE_SERVICE_URL=http://localhost:8000

# SMTP Configuration (for sending emails)
# Using Resend (recommended): smtp.resend.com with API key
# For Gmail: use smtp.gmail.com with App Password (not your regular password)
# For SendGrid: smtp.sendgrid.net with API key as password
# For Mailgun: smtp.mailgun.org with SMTP credentials
# For Amazon SES: email-smtp.us-east-1.amazonaws.com with SMTP credentials
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_api_key_here
SMTP_FROM=Kyarafit <onboarding@resend.dev>

# Application URL (for email links)
APP_URL=http://localhost:3000
