name: Deploy to Fly.io (DISABLED - Using GCP Cloud Run)

# This workflow has been disabled in favor of GCP Cloud Run deployment
# See: .github/workflows/deploy-gcp-*.yml

# To re-enable:
# 1. Rename this file to deploy-fly.yml (remove .disabled)
# 2. Move to .github/workflows/
# 3. Ensure FLY_API_TOKEN secret is configured
# 4. Disable GCP workflows to avoid conflicts

on:
  # workflow_dispatch:  # Uncomment to enable manual trigger only

  # push:
  #   branches: [ main ]  # Uncomment to enable automatic deployment

jobs:
  deploy-backend:
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Go
      uses: actions/setup-go@v4
      with:
        go-version: '1.21'

    - name: Install Fly CLI
      uses: superfly/flyctl-actions/setup-flyctl@master

    - name: Deploy Backend to Fly.io
      working-directory: ./backend
      env:
        FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
      run: |
        flyctl deploy --remote-only

  deploy-web:
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '18'
        cache: 'npm'
        cache-dependency-path: web/package-lock.json

    - name: Install dependencies
      working-directory: ./web
      run: npm ci

    - name: Build application
      working-directory: ./web
      run: npm run build

    - name: Install Fly CLI
      uses: superfly/flyctl-actions/setup-flyctl@master

    - name: Deploy Web to Fly.io
      working-directory: ./web
      env:
        FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
      run: |
        flyctl deploy --remote-only

  deploy-image-service:
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.11'

    - name: Install dependencies
      working-directory: ./image-service
      run: pip install -r requirements.txt

    - name: Install Fly CLI
      uses: superfly/flyctl-actions/setup-flyctl@master

    - name: Deploy Image Service to Fly.io
      working-directory: ./image-service
      env:
        FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
      run: |
        flyctl deploy --remote-only
