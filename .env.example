# ============================================
# Kyarafit Environment Variables
# ============================================
# SECURITY: Never commit real secrets. BETTER_AUTH_SECRET, RESEND_API_KEY,
# GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_SECRET must be set only in Convex
# Dashboard (Settings → Environment Variables), never in client bundles or .env
# committed to git. Web/mobile use only NEXT_PUBLIC_* / EXPO_PUBLIC_* (URLs).

# Convex (auto-generated by `npx convex dev`)
# These are typically stored in .env.local
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Better Auth (OAuth providers)
# Google OAuth - required (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - optional (get from https://github.com/settings/developers)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Sign in with Apple — optional (Service ID + JWT client secret from Apple Developer)
# Client secret expires in at most ~6 months; regenerate and update Convex env.
#APPLE_CLIENT_ID=com.example.app.si
#APPLE_CLIENT_SECRET=eyJ...
# APPLE_APP_BUNDLE_IDENTIFIER=com.example.app

# Required on every Convex deployment (at least 32 characters); no default secret.
# Provision signing material outside source control (e.g. openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Convex auth/CORS configuration (not client env). Production is the default.
# Set AUTH_ENVIRONMENT=development ONLY on an isolated dev deployment for localhost/Expo.
# Production SITE_URL and ADDITIONAL_CORS_ORIGINS must be HTTPS origins, not paths.
# AUTH_ENVIRONMENT=production
# SITE_URL=https://app.kyarafit.com
# ADDITIONAL_CORS_ORIGINS=
# Before deploying this configuration, move any existing localhost/Expo origins to
# an isolated deployment with AUTH_ENVIRONMENT=development; production rejects them.

# Welcome-email app link (independent of Convex auth SITE_URL)
APP_URL=http://localhost:3000

# Email (Resend — https://resend.com)
# Set in the Convex dashboard → Settings → Environment Variables
# Get your API key at https://resend.com/api-keys
# Without this, email sending is silently skipped (app still works).
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Kyarafit <noreply@yourdomain.com>

# Stripe (optional; mobile billing uses RevenueCat)
# STRIPE_PRICE_BASIC=price_xxx
# STRIPE_PRICE_PRO=price_yyy

# RevenueCat → Convex (set in Convex Dashboard → Environment Variables)
# REVENUECAT_SECRET_API_KEY=        # Required server key; webhook returns 503 when unset
# REVENUECAT_WEBHOOK_AUTHORIZATION=  # Required shared secret; webhook returns 401 when unset
# Webhook URL: https://<deployment>.convex.site/webhooks/revenuecat
# See docs/billing/REVENUECAT_SETUP.md

# Mobile (Expo) - set in mobile/.env
# EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Optional generic key for local development only; blank disables local billing.
# EXPO_PUBLIC_REVENUECAT_API_KEY=
# Native release requires the matching platform SDK key (appl_ / goog_), never a test key.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Web (Next.js) — RevenueCat Web Billing public SDK key (see docs/billing/REVENUECAT_SETUP.md)
# NEXT_PUBLIC_REVENUECAT_WEB_BILLING_API_KEY=rcb_...
