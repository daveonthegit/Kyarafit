# Supabase credentials (get from https://app.supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# IMPORTANT: JWT_SECRET is the JWT Secret from Supabase (NOT the anon key!)
# Get it from: Project Settings → API → JWT Secret (click "Reveal" to see it)
JWT_SECRET=your-jwt-secret-from-supabase
SUPABASE_SERVICE_KEY=your-service-role-key

# Stripe (optional, for Premium subscriptions)
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_yyy

# Database 
# For local Docker postgres: postgres://kyarafit:kyarafit@localhost:5432/kyarafit?sslmode=disable
# For Supabase: postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# Server
PORT=8080
HOST=0.0.0.0

# CORS Origins (comma-separated list of allowed origins)
# For local dev, include all localhost/127.0.0.1 ports you use
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081

# SMTP Configuration (OPTIONAL - backend will start without these)
# Email features will be disabled if not configured
# Using Resend (recommended): smtp.resend.com with API key
# For Gmail: use smtp.gmail.com with App Password (not your regular password)
# For SendGrid: smtp.sendgrid.net with API key as password
# For Mailgun: smtp.mailgun.org with SMTP credentials
# For Amazon SES: email-smtp.us-east-1.amazonaws.com with SMTP credentials
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_api_key_here
SMTP_FROM=Kyarafit <onboarding@resend.dev>

# Application URL (for email links)
APP_URL=http://localhost:3000

# Optional: Image processing service (for background removal)
IMAGE_SERVICE_URL=http://localhost:8000

# Web Frontend (for reference - these go in web/.env.local)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# NEXT_PUBLIC_API_URL=http://localhost:8080
