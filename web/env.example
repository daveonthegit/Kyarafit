# Database
DATABASE_URL="postgresql://kyarafit:password@localhost:5432/kyarafit?schema=public"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Next (monorepo: skip lockfile patch to avoid ENOWORKSPACES / patch errors)
NEXT_IGNORE_INCORRECT_LOCKFILE=1

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Backend base URL (Closet API: GET/POST /closet/items; no /api/v1 prefix)
NEXT_PUBLIC_API_URL="http://localhost:8080"
NEXT_PUBLIC_IMAGE_SERVICE_URL="http://localhost:8001"
