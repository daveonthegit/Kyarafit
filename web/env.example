# Database
DATABASE_URL="postgresql://kyarafit:password@localhost:5432/kyarafit?schema=public"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Next (monorepo: skip lockfile patch to avoid ENOWORKSPACES / patch errors)
NEXT_IGNORE_INCORRECT_LOCKFILE=1

# Convex (required for auth; npx convex dev writes these to root .env.local — copy to web/.env.local for Next.js)
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# RevenueCat Web Billing (@revenuecat/purchases-js) — Stripe is connected inside RevenueCat only
# NEXT_PUBLIC_REVENUECAT_WEB_BILLING_API_KEY=rcb_...

# App
# Drives CSP / CORS Allow-Origin / HSTS in web/next.config.js. Production: https://app.kyarafit.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NOTE: NEXT_PUBLIC_API_URL / NEXT_PUBLIC_IMAGE_SERVICE_URL are legacy from the removed Go backend +
# image service. The current backend is Convex (see NEXT_PUBLIC_CONVEX_URL above); these vars are not
# read anywhere in web/src and can be omitted.
