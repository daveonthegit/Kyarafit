{
  "name": "kyarafit",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "design-system"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "lint": "npm run lint -w web && npm run lint -w mobile && npm run lint -w design-system",
    "lint:web": "npm run lint -w web",
    "lint:mobile": "npm run lint -w mobile",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w mobile",
    "typecheck:web": "npm run typecheck -w web",
    "typecheck:mobile": "npm run typecheck -w mobile",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "build:web": "npm run build -w web",
    "test": "npm run test -w web",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "i18n:check": "node scripts/i18n/check-keys.mjs",
    "apple:client-secret": "node scripts/generate-apple-client-secret.mjs",
    "validate": "npm run format:check && npm run i18n:check && npm run lint && npm run typecheck && npm run build:web",
    "ci": "bash scripts/ci-local.sh",
    "ci:win": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.24",
    "convex-test": "^0.0.53",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.6",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@convex-dev/migrations": "^0.3.3",
    "@kyarafit/design-system": "*",
    "convex": "^1.32.0",
    "expo-router": "~55.0.13",
    "jose": "^6.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "6.9.3"
  },
  "overrides": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-native": {
      "hermes-compiler": "250829098.0.4"
    }
  },
  "resolutions": {
    "hermes-compiler": "250829098.0.4"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.27.0"
  }
}
