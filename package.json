{
  "name": "kyarafit",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "design-system"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "lint": "npm run lint -w web && npm run lint -w mobile && npm run lint -w design-system",
    "lint:web": "npm run lint -w web",
    "lint:mobile": "npm run lint -w mobile",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w mobile",
    "typecheck:web": "npm run typecheck -w web",
    "typecheck:mobile": "npm run typecheck -w mobile",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "build:web": "npm run build -w web",
    "test": "npm run test -w web",
    "test:backend": "cd backend && go test ./...",
    "test:image-service": "cd image-service && python -m pytest",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run build:web",
    "ci": "bash scripts/ci-local.sh",
    "ci:win": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.19"
  }
}
