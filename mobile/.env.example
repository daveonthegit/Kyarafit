# Convex deployment URL — get this from `npx convex dev` or the Convex dashboard
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL for auth callbacks (better-auth HTTP endpoint)
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public web app origin for share links / "open in web" (e.g. https://app.kyarafit.com).
# NOTE: the code reads EXPO_PUBLIC_WEB_APP_URL (see mobile/src/config/env.ts); this MUST match or the
# "open in web" links silently no-op. Optional; falls back to an in-app alert if unset.
EXPO_PUBLIC_WEB_APP_URL=https://app.kyarafit.com

# RevenueCat public SDK keys from your project; no fallback is supplied.
# Local development can leave all keys blank for non-billing mode.
# The generic key is development-only. Native release requires its own platform
# key (iOS appl_ / Android goog_); missing, test or wrong-platform keys fail startup.
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Internal Convex deployment name (used by CLI)
CONVEX_DEPLOYMENT=dev:your-deployment
