# Convex deployment URL — get this from `npx convex dev` or the Convex dashboard
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL for auth callbacks (better-auth HTTP endpoint)
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Internal Convex deployment name (used by CLI)
CONVEX_DEPLOYMENT=dev:your-deployment
