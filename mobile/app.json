{
  "expo": {
    "name": "Kyarafit",
    "slug": "kyarafit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kyarafit.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Kyarafit uses the camera only when you choose to take a photo for cosplay items, builds, or your profile.",
        "NSPhotoLibraryUsageDescription": "Kyarafit needs access to your photo library only when you choose images for cosplay items, builds, or profile pictures.",
        "NSPhotoLibraryAddUsageDescription": "Kyarafit may save edited cosplay images back to your library only when you choose to export or save them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kyarafit.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useHermesV1": true,
            "buildReactNativeFromSource": true
          },
          "android": {
            "useHermesV1": true,
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "scheme": "kyarafit",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ee198618-96ee-4330-9c3d-cefd43f6b68a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "enableBsdiffPatchSupport": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee198618-96ee-4330-9c3d-cefd43f6b68a"
      }
    },
    "owner": "shukishi"
  }
}
