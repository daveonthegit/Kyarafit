  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "test": "node eslint-rules/require-data-boundary.test.cjs",
    "build:android": "npx eas build --platform android",
    "build:ios": "npx eas build --platform ios",
    "submit:android": "npx eas submit --platform android",
    "submit:ios": "npx eas submit --platform ios",
    "check:env": "node scripts/check-expo-public-env.js"
  },
