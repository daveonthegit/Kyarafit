{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "convex/_generated/api": ["../convex/_generated/api"],
      "convex/_generated/dataModel": ["../convex/_generated/dataModel"],
      "convex/_generated/server": ["../convex/_generated/server"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "global.d.ts",
    "nativewind-env.d.ts"
  ]
}
